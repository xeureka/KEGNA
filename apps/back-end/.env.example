NODE_ENV=development
LOG_LEVEL=debug | info 
PORT=3000
HOST=0.0.0.0

# Local Docker PostgreSQL database
DATABASE_URL=postgresql://nexa_app:nexa_app@127.0.0.1:5432/nexa_crm

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
WEB_APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081,https://app.yourdomain.com

# Chapa payment provider configuration.
#
# CHAPA_MODE selects the key pair used for every gateway call:
#   test  -> CHAPA_TEST_SECRET_KEY / CHAPA_TEST_PUBLIC_KEY  (sandbox, default)
#   live  -> CHAPA_LIVE_SECRET_KEY / CHAPA_LIVE_PUBLIC_KEY  (real money)
# CHAPA_SECRET_KEY / CHAPA_PUBLIC_KEY are a fallback for deployments that only
# set those two. The mode-specific pair above wins when present.
#
# Never expose any of these keys to the mobile or web client.
CHAPA_MODE=test
CHAPA_TEST_SECRET_KEY=
CHAPA_TEST_PUBLIC_KEY=
CHAPA_LIVE_SECRET_KEY=
CHAPA_LIVE_PUBLIC_KEY=
# Optional override for both modes (deprecated in favour of the pair above).
CHAPA_SECRET_KEY=
CHAPA_PUBLIC_KEY=
# Webhook HMAC secret from Chapa Dashboard → Settings → Webhooks.
# Required in production: every webhook without it is rejected with 401.
CHAPA_WEBHOOK_SECRET=
# Chapa API origin; the same endpoint is used for test and live keys.
CHAPA_BASE_URL=https://api.chapa.co/v1
# Public HTTPS URL for the signed Chapa webhook endpoint.
CHAPA_CALLBACK_URL=https://api.yourdomain.com/api/v1/payments/chapa/webhook
# Public HTTPS return bridge; it redirects to nexa-<tenant-slug>://payment-return.
CHAPA_RETURN_URL=https://api.yourdomain.com/api/v1/payments/chapa/return
# Platform service charge for Chapa payments only, in ETB; cash/transfer charge is zero.
SERVICE_CHARGE_ETB=50
# Minutes an unpaid appointment slot remains held.
PAYMENT_HOLD_MINUTES=30

# SMSEthiopia OTP delivery (https://smsethiopia.com). Create a key in
# Console → API Keys. On the free test campaign, only dashboard-verified
# numbers receive SMS (error 10007 otherwise). Never expose this to clients.
SMS_ETHIOPIA=
SMS_ETHIOPIA_BASE_URL=https://smsethiopia.com/api
