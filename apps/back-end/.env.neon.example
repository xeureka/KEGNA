NODE_ENV=development
LOG_LEVEL=debug

PORT=3001
HOST=0.0.0.0

# Copy the Neon pooled/direct connection string from your team secret store.
DATABASE_URL=postgresql://<neon-user>:<neon-password>@<neon-host>/<neon-database>?sslmode=require

BETTER_AUTH_SECRET=replace_with_a_secret_at_least_32_characters_long
BETTER_AUTH_URL=http://<windows-lan-ip>:3001
WEB_APP_URL=http://<windows-lan-ip>:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://<windows-lan-ip>:5173,http://<windows-lan-ip>:8081
