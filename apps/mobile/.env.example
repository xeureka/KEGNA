# ZOLA mobile environment example.
#
# The back-end listens on port 3001 and serves the API under /api.
# Set this to a URL the device/simulator can actually reach:
#   - Physical device (Expo Go): http://<computer-LAN-IP>:3001
#   - Android emulator:          http://10.0.2.2:3001
#   - iOS simulator:             http://localhost:3001
#
# Leave unset during normal Metro development to derive the host from Expo's
# hostUri instead. Production/EAS builds must set an https URL.
# Replace the example LAN IP with your computer's current address.
EXPO_PUBLIC_API_URL=http://192.168.1.10:3001
